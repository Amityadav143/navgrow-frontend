# ==========================================================================
# Navgrow Engineering — Apache config (Hostinger)
# SPA routing + correct MIME types + long-lived caching for performance.
# ==========================================================================

<IfModule mod_mime.c>
  # Serve sitemap/robots/feed with the RIGHT content type. Without this the
  # host can mislabel sitemap.xml and Search Console reports it as an HTML page.
  AddType application/xml            .xml
  AddType text/plain                 .txt
  AddType application/manifest+json  .webmanifest
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---- Canonical domain --------------------------------------------------
  # Other domains/subdomains (e.g. navgrow.tech, www.navgrow.org) point at this
  # same hosting, which would let Google index the site under several hostnames
  # and split ranking signals as "duplicate content". Force ONE canonical host:
  # 301-redirect every request whose host is not navgrow.org to navgrow.org.
  # (Skipped automatically on localhost so local dev is unaffected.)
  RewriteCond %{HTTP_HOST} !^navgrow\.org$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://navgrow.org/$1 [R=301,L]

  # Short-circuit the crawler files so nothing can shadow them.
  RewriteRule ^(sitemap\.xml|sitemap-index\.xml|robots\.txt|llms\.txt)$ - [L]

  # The per-build page folders (/_p/<build>/…) are served only through the rules
  # below, never by their own address (that would be duplicate content).
  RewriteCond %{THE_REQUEST} \s/+_p/ [NC]
  RewriteRule ^ - [R=404,L]

  # Serve real static files (hashed JS/CSS, images, fonts, manifest) as-is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ---- Product, news and service pages of THIS build ----------------------
  # The build writes them to /_p/<build>/ and scripts/prerender.mjs writes its
  # id into these rules (and the X-Navgrow-Build header). Pages left on the
  # server by older uploads — e.g. /shop/<old-product>/index.html, with the old
  # markup Google kept reporting — are never served: products that are gone get
  # og.php's 404 instead.
  RewriteCond %{DOCUMENT_ROOT}/_p/__NAVGROW_BUILD__/$1/index.html -f
  RewriteRule ^((?:shop|news|services)/[^/]+?)/?$ /_p/__NAVGROW_BUILD__/$1/index.html [L]

  # ---- Serve PRERENDERED HTML for the other routes ------------------------
  # /about, /shop, /news, /services, … are prerendered to <route>/index.html so
  # crawlers receive real HTML with JSON-LD (never the empty SPA shell). Serving
  # the file (not the directory) avoids a trailing-slash redirect. Single
  # product/news/service URLs are excluded: only this build's copies (above).
  RewriteCond $1 !^(shop|news|services)/[^/]+$
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # ---- Crawlers on DB-ONLY products/posts --------------------------------
  # Products/news created after the last build have no prerendered file above.
  # Search engines and link-preview bots get a PHP-rendered page instead: the
  # live record's title, canonical, Open Graph tags, complete Product /
  # BlogPosting JSON-LD and real body text (og.php). All Google crawlers are
  # listed — including Google-InspectionTool, used by Search Console's URL
  # Inspection and the Rich Results Test, which used to get the bare shell.
  # Humans fall through to the normal SPA below. (og.php re-checks the
  # user-agent and fails safe to the prerendered page or the shell.)
  RewriteCond %{HTTP_USER_AGENT} (Googlebot|Google-InspectionTool|GoogleOther|Storebot-Google|AdsBot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|Baiduspider|Applebot|PetalBot|facebookexternalhit|facebot|WhatsApp|LinkedInBot|Twitterbot|Slackbot|TelegramBot|Pinterest|redditbot|Discordbot|SkypeUriPreview|vkShare|Embedly) [NC]
  RewriteRule ^shop/([^/]+)/?$ /og.php?type=product&slug=$1 [L,QSA]
  RewriteCond %{HTTP_USER_AGENT} (Googlebot|Google-InspectionTool|GoogleOther|Storebot-Google|AdsBot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|Baiduspider|Applebot|PetalBot|facebookexternalhit|facebot|WhatsApp|LinkedInBot|Twitterbot|Slackbot|TelegramBot|Pinterest|redditbot|Discordbot|SkypeUriPreview|vkShare|Embedly) [NC]
  RewriteRule ^news/([^/]+)/?$ /og.php?type=news&slug=$1 [L,QSA]

  # Root: serve the homepage's index.html explicitly.
  RewriteRule ^/?$ index.html [L]

  # SPA fallback for everything else (genuinely dynamic/unknown routes) —
  # app.html, the NEUTRAL shell with no canonical. It used to be index.html,
  # i.e. the homepage's prerendered HTML, so every such URL declared the
  # homepage as its canonical and Google dropped it as a duplicate.
  RewriteCond %{DOCUMENT_ROOT}/app.html -f
  RewriteRule ^ app.html [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Avoid the automatic trailing-slash 301 on directory requests: we serve the
# prerendered index.html for extensionless URLs above, so the redirect would
# only add a needless hop for crawlers. Guarded so it never errors if the host
# restricts this directive.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_headers.c>
  Header set X-Powered-By "Navgrow"
  # Which build answered — npm run verify:seo compares it with each page's
  # <meta name="navgrow-build"> to spot pages left over from older uploads.
  Header set X-Navgrow-Build "__NAVGROW_BUILD__"

  # --- Hashed build assets (immutable): cache hard for a year --------------
  <FilesMatch "\.(js|css|woff2?|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- Images: long cache, revalidate ------------------------------------
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # --- HTML entrypoint: always revalidate so deploys are picked up --------
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Service worker: never cache, so SW updates roll out immediately -----
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # --- Crawler files: short cache -----------------------------------------
  <FilesMatch "(sitemap.*\.xml|robots\.txt|llms\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression -- smaller transfers, faster LCP.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
