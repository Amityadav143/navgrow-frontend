# `npm run build` — production bundle served at https://navgrow.org
# '/api' = same-origin, reverse-proxied by nginx to the Spring Boot backend.
# NEVER put localhost here; the code additionally refuses localhost in prod builds.
VITE_API_BASE_URL=/api
# Set your LIVE Razorpay key at build time or here:
# VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
